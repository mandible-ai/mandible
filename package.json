{
  "name": "mandible",
  "version": "0.1.0",
  "description": "Universal stigmergy framework for autonomous agent coordination — like ant colonies using pheromone trails",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./environments/filesystem": {
      "types": "./dist/environments/filesystem/index.d.ts",
      "import": "./dist/environments/filesystem/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "bin": {
    "mandible": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "stigmergy",
    "agents",
    "multi-agent",
    "coordination",
    "framework",
    "autonomous",
    "ai",
    "llm",
    "colony",
    "pheromone"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mandible-dev/mandible"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch examples/code-pipeline/index.ts",
    "demo": "tsx examples/code-pipeline/index.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "chokidar": "^4.0.0",
    "eventemitter3": "^5.0.0",
    "nanoid": "^5.0.0",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=0.1.0",
    "@ai-sdk/google": ">=0.1.0",
    "@ai-sdk/openai": ">=0.1.0",
    "@anthropic-ai/claude-agent-sdk": ">=0.1.0",
    "@anthropic-ai/sdk": ">=0.30.0",
    "ai": ">=3.0.0",
    "openai": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.47",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
